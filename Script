-- ============================================
-- DRAGGABLE FUNCTIONALITY
-- ============================================

local dragging = false
local dragStart = nil
local dragStartX = 0
local dragStartY = 0
local userInputService = game:GetService("UserInputService")

-- Mouse/Touch down on the frame (starts drag)
frame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or 
       input.UserInputType == Enum.UserInputType.Touch then
        
        -- Don't drag if clicking on buttons
        if input.Target:IsA("TextButton") then
            return
        end
        
        dragging = true
        dragStart = input.Position
        dragStartX = frame.Position.X.Offset
        dragStartY = frame.Position.Y.Offset
        
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

-- Track mouse/touch movement
local function onInputChanged(input)
    if not dragging then return end
    
    if input.UserInputType == Enum.UserInputType.MouseMovement or 
       input.UserInputType == Enum.UserInputType.Touch then
        
        local delta = input.Position - dragStart
        
        frame.Position = UDim2.new(
            0,
            dragStartX + delta.X,
            0,
            dragStartY + delta.Y
        )
    end
end

userInputService.InputChanged:Connect(onInputChanged)

-- Also handle touch movement separately for mobile
userInputService.TouchMoved:Connect(function(touch)
    if not dragging then return end
    
    local delta = touch.Position - dragStart
    frame.Position = UDim2.new(
        0,
        dragStartX + delta.X,
        0,
        dragStartY + delta.Y
    )
end)

-- Stop dragging when mouse/touch is released
userInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or 
       input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

-- ============================================
-- MINIMIZE FUNCTION
-- ============================================
local function minimizeGUI()
    isMinimized = not isMinimized
    
    if isMinimized then
        contentFrame.Visible = false
        frame.Size = UDim2.new(0, 260, 0, 40)
        minimizeButton.Text = "+"
        statusLabel.Text = "📎 Minimized"
        statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    else
        contentFrame.Visible = true
        frame.Size = UDim2.new(0, 260, 0, 160)
        minimizeButton.Text = "−"
        if savedPosition then
            local pos = savedPosition
            statusLabel.Text = string.format("✅ Saved at (%.1f, %.1f, %.1f)", pos.X, pos.Y, pos.Z)
            statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        else
            statusLabel.Text = "📍 No position saved"
            statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    end
end

-- Connect minimize button
minimizeButton.MouseButton1Click:Connect(minimizeGUI)
minimizeButton.TouchTap:Connect(minimizeGUI)

-- ============================================
-- FUNCTIONS
-- ============================================

-- Update status label
local function updateStatus(text, color)
    if not isMinimized then
        statusLabel.Text = text
        if color then
            statusLabel.TextColor3 = color
        else
            statusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
        end
    end
end

-- Save Position
local function savePosition()
    if not character or not humanoidRootPart then
        updateStatus("❌ Character not found!", Color3.fromRGB(255, 80, 80))
        return
    end
    
    savedPosition = humanoidRootPart.Position
    savedCFrame = humanoidRootPart.CFrame
    
    local pos = savedPosition
    updateStatus(string.format("✅ Saved at (%.1f, %.1f, %.1f)", pos.X, pos.Y, pos.Z), Color3.fromRGB(200, 255, 200))
    
    -- Visual feedback on button (white flash)
    saveButton.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    saveButton.TextColor3 = Color3.fromRGB(0, 0, 0)
    task.wait(0.15)
    saveButton.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    saveButton.TextColor3 = Color3.fromRGB(255, 255, 255)
end

-- Teleport to saved position
local function teleportToSaved()
    if not savedPosition then
        updateStatus("⚠️ No position saved!", Color3.fromRGB(255, 200, 50))
        return
    end
    
    if not character or not humanoidRootPart then
        updateStatus("❌ Character not found!", Color3.fromRGB(255, 80, 80))
        return
    end
    
    -- Teleport
    humanoidRootPart.CFrame = savedCFrame or CFrame.new(savedPosition)
    
    local pos = savedPosition
    updateStatus(string.format("🚀 Teleported to (%.1f, %.1f, %.1f)", pos.X, pos.Y, pos.Z), Color3.fromRGB(200, 255, 255))
    
    -- Visual feedback on button (white flash)
    teleportButton.BackgroundColor3 = Color3.fromRGB(200, 200, 200)
    teleportButton.TextColor3 = Color3.fromRGB(0, 0, 0)
    task.wait(0.15)
    teleportButton.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    teleportButton.TextColor3 = Color3.fromRGB(255, 255, 255)
end

-- ============================================
-- BUTTON CONNECTIONS
-- ============================================
saveButton.MouseButton1Click:Connect(savePosition)
teleportButton.MouseButton1Click:Connect(teleportToSaved)

-- Touch support for mobile
saveButton.TouchTap:Connect(savePosition)
teleportButton.TouchTap:Connect(teleportToSaved)

-- ============================================
-- KEYBOARD SHORTCUTS
-- ============================================
userInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    
    if input.KeyCode == Enum.KeyCode.P then
        savePosition()
    elseif input.KeyCode == Enum.KeyCode.T then
        teleportToSaved()
    elseif input.KeyCode == Enum.KeyCode.M then
        minimizeGUI()
    end
end)

-- ============================================
-- HANDLE CHARACTER RESPAWN
-- ============================================
player.CharacterAdded:Connect(function(newCharacter)
    character = newCharacter
    humanoidRootPart = character:WaitForChild("HumanoidRootPart")
    if not isMinimized then
        updateStatus("🔄 Respawned. Position saved.", Color3.fromRGB(200, 200, 200))
    end
end)

